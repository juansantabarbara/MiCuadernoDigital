  const GRADE_SCALE=['—','INS','SUF','BI','NOT','SOBRE'];

  function migrateGradeValue(v){
    // Los antiguos EP / I / A pertenecían al prototipo y no tienen equivalencia válida
    // con INS / SUF / BI / NOT / SOBRE. Para no inventar una calificación, al migrar
    // quedan como «— Sin calificar».
    if(v==='EP' || v==='I' || v==='A') return '—';
    if(GRADE_SCALE.includes(v)) return v;
    return '—';
  }
  function migrateAllGrades(){
    Object.keys(data.evidence||{}).forEach(sid=>{
      Object.keys(data.evidence[sid]||{}).forEach(cid=>{
        data.evidence[sid][cid]=migrateGradeValue(data.evidence[sid][cid]);
      });
    });
  }

  function curriculumBank(){
    const grade=document.querySelector('#curriculum-grade')?.value||'5';
    const area=document.querySelector('#curriculum-area')?.value||'matematicas';
    return ASTURIAS_CURRICULUM?.[grade]?.[area]||[];
  }
  function curriculumKey(c){ return `${c.ce}|${c.code}|${c.text}`; }

  function renderCurriculumBank(){
    const box=document.querySelector('#curriculum-bank-list'); if(!box)return;
    const u=selectedUnit(); if(!u)return;
    const selected=new Set((u.curricularCriteria||[]).map(c=>curriculumKey(c)));
    const items=curriculumBank();
    box.innerHTML=items.map(c=>`
      <label class="curriculum-bank-item">
        <input type="checkbox" class="curriculum-bank-check" value="${esc(c.code)}" ${selected.has(curriculumKey(c))?'disabled':''}>
        <span>
          <strong>${esc(c.code)} · ${esc(c.text)}</strong>
          <span class="ce-title">${esc(c.ce)} · ${esc(c.ceText)}</span>
          <span class="desc">Descriptores: ${esc(c.descriptors)}</span>
        </span>
      </label>`).join('');
  }

  function addSelectedCurriculum(){
    const u=selectedUnit(); if(!u)return;
    const bank=curriculumBank();
    const codes=[...document.querySelectorAll('.curriculum-bank-check:checked')].map(x=>x.value);
    if(!codes.length)return toast('Selecciona al menos un criterio.');
    const existing=new Set((u.curricularCriteria||[]).map(c=>curriculumKey(c)));
    codes.forEach(code=>{
      const c=bank.find(x=>x.code===code);
      if(c && !existing.has(curriculumKey(c))){
        u.curricularCriteria.push({
          id:uid('crit'),
          code:c.code,
          text:c.text,
          ce:c.ce,
          ceText:c.ceText,
          descriptors:c.descriptors,
          source:'asturias',
          grade:document.querySelector('#curriculum-grade')?.value||'5',
          area:document.querySelector('#curriculum-area')?.value||'matematicas'
        });
      }
    });
    syncCurricularEvidenceColumns();
    save('Criterios curriculares añadidos');
    renderUnitCurriculum();
  }

  function descriptorCompetencies(descriptors=''){
    return [...new Set(String(descriptors).split(/[,;\s]+/).map(x=>x.trim()).filter(Boolean).map(x=>{
      const m=x.toUpperCase().match(/^(CCL|CP|STEM|CD|CPSAA|CC|CE|CCEC)/); return m?m[1]:'';
    }).filter(Boolean))];
  }
  function curricularColumns(){
    const out=[];
    (data.units||[]).forEach(u=>{
      (u.products||[]).forEach(p=>{
        (p.criterionIds||[]).forEach(crid=>{
          const cr=(u.curricularCriteria||[]).find(x=>x.id===crid); if(!cr)return;
          const id=`cur_${u.id}_${p.id}_${cr.id}`;
          out.push({id,label:`${p.name} · ${cr.code||'Criterio'}`,criterion:cr.code||'',criterionText:cr.text||'',specificCompetence:cr.ce||'',descriptors:cr.descriptors||'',competency:descriptorCompetencies(cr.descriptors).join(' / '),unitId:u.id,unitTitle:u.title,productId:p.id,productName:p.name,source:'curricular'});
        });
      });
    });
    return out;
  }
  function syncCurricularEvidenceColumns(){
    const manual=(data.evidenceColumns||[]).filter(c=>c.source!=='curricular');
    const generated=curricularColumns();
    const old=data.evidenceColumns||[];
    generated.forEach(c=>{
      const prev=old.find(x=>x.id===c.id);
      if(prev) Object.assign(c,prev,{label:c.label,criterion:c.criterion,criterionText:c.criterionText,specificCompetence:c.specificCompetence,descriptors:c.descriptors,competency:c.competency,unitId:c.unitId,unitTitle:c.unitTitle,productId:c.productId,productName:c.productName,source:'curricular'});
    });
    data.evidenceColumns=[...manual,...generated];
    data.students.forEach(st=>{data.evidence[st.id]=data.evidence[st.id]||{};generated.forEach(c=>{if(!(c.id in data.evidence[st.id]))data.evidence[st.id][c.id]='—'})});
  }

