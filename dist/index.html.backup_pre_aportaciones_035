  function openSection(id){
    if(!document.querySelector('#'+id)) return;
    document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));
    document.querySelector('#'+id).classList.add('active');
    document.querySelectorAll('nav button').forEach(b=>b.classList.toggle('active',b.dataset.section===id));
    document.querySelector('#page-title').textContent=pageInfo[id][0];
    document.querySelector('#page-subtitle').textContent=pageInfo[id][1];
    window.scrollTo({top:0,behavior:'smooth'});
  }
  function applyMode(mode,goHome=true){
    currentMode=mode; data.settings=data.settings||{}; data.settings.mode=mode; persistState();
    document.querySelectorAll('.mode-switch button').forEach(b=>b.classList.toggle('active',b.dataset.mode===mode));
    document.querySelector('#mode-label').textContent=mode==='diario'?'Modo Diario':'Modo Evaluación';
    document.querySelectorAll('nav button[data-section]').forEach(b=>b.classList.toggle('hidden',!modeSections[mode].includes(b.dataset.section)));
