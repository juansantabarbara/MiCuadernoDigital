  document.querySelector('#meeting-new-person').onkeydown=e=>{if(e.key==='Enter'){e.preventDefault();addMeetingPerson()}};
  document.querySelector('#meeting-filter').onchange=renderMeetings;
  document.querySelector('#meeting-cancel-edit').onclick=resetMeetingForm;
  document.querySelector('#act-save').onclick=saveActuation;
  document.querySelector('#act-cancel-edit').onclick=resetActuationForm;
  document.querySelector('#act-filter-scope').onchange=renderActuations;
  document.querySelector('#act-filter-status').onchange=renderActuations;
  document.querySelector('#act-search').oninput=renderActuations;
  resetMeetingForm();
  document.querySelector('#custom-day-add').onclick=addCustomDay;
  document.querySelector('#custom-day-start').value=today();
  document.querySelector('#custom-day-end').value=today();
  document.querySelector('#guardar-unidad').onclick=saveUnit;
  document.querySelector('#unidad-fecha').value=today();
  document.querySelector('#guardar-unidad-completa').onclick=saveUnitDetails;
  document.querySelector('#add-unit-criterion').onclick=addUnitCriterion;
  document.querySelector('#add-selected-curriculum').onclick=addSelectedCurriculum;
  document.querySelector('#curriculum-grade').onchange=renderCurriculumBank;
  document.querySelector('#curriculum-area').onchange=renderCurriculumBank;
  document.querySelector('#select-all-curriculum').onclick=()=>document.querySelectorAll('.curriculum-bank-check:not(:disabled)').forEach(x=>x.checked=true);
  document.querySelector('#add-unit-product').onclick=addUnitProduct;
  document.querySelector('#guardar-sesion').onclick=saveSession;
  document.querySelector('#cancelar-edicion-sesion').onclick=()=>clearSessionForm(true);
  document.querySelector('#nuevo-alumno').onclick=()=>studentModal(false);
  document.querySelector('#editar-alumno').onclick=()=>studentModal(true);
  document.querySelector('#eliminar-alumno').onclick=()=>{
  const st=student();
  if(!st){toast('No hay ningún alumno seleccionado.');return}

  const sid=st.id;
  const nombre=st.name;

  modal(
    'Eliminar alumno/a',
    `<p>¿Seguro que quieres eliminar a <strong>${esc(nombre)}</strong>?</p>
     <div class="notice" style="margin-top:14px;background:#fef2f2;border-color:#fecaca;color:#991b1b">
       Se eliminarán también sus evidencias, observaciones y registros asociados. Esta acción no se puede deshacer.
     </div>`,
    ()=>{
      data.students=data.students.filter(s=>s.id!==sid);

      if(data.evidence) delete data.evidence[sid];

      if(Array.isArray(data.observations)){
        data.observations=data.observations.filter(o=>o.studentId!==sid);
      }

      if(data.attendance && typeof data.attendance==='object'){
        Object.values(data.attendance).forEach(rec=>{
          if(rec && typeof rec==='object') delete rec[sid];
        });
      }

      if(Array.isArray(data.feedback)){
        data.feedback=data.feedback.filter(x=>x.studentId!==sid);
      }

      if(Array.isArray(data.feedbacks)){
        data.feedbacks=data.feedbacks.filter(x=>x.studentId!==sid);
      }

      data.selectedStudentId=data.students[0]?.id||'';

      if(data.intelligenceStudentId===sid){
        data.intelligenceStudentId=data.students[0]?.id||'';
      }

      if(data.settings?.notebookStudentId===sid){
        data.settings.notebookStudentId=data.students[0]?.id||'';
      }

      save('Alumno eliminado');
      return true;
    }
  );

  const btn=document.querySelector('#modal-save');
  if(btn){
    btn.textContent='Eliminar definitivamente';
    btn.classList.add('danger');
  }
};
  document.querySelectorAll('[data-notebook-view]').forEach(b=>b.onclick=()=>{data.settings.notebookView=b.dataset.notebookView;persistState();renderNotebook()});
  document.querySelector('#notebook-search').oninput=e=>{data.settings.notebookSearch=e.target.value;persistState();renderNotebook();const x=document.querySelector('#notebook-search');if(x){x.focus();x.setSelectionRange(x.value.length,x.value.length)}};
  document.querySelector('#notebook-competency').onchange=e=>{data.settings.notebookCompetency=e.target.value;persistState();renderNotebook()};
  document.querySelector('#notebook-evidence-filter').onchange=e=>{data.settings.notebookEvidence=e.target.value;persistState();renderNotebook()};
  document.querySelector('#nueva-evidencia-local').onclick=evidenceModal;
  const topButtons=[...document.querySelectorAll('.topbar .actions button')];
  topButtons.find(b=>b.textContent.includes('Nueva observación')).onclick=()=>{applyMode('diario',false);openSection('diario');document.querySelector('#diario-text').focus()};
  topButtons.find(b=>b.textContent.includes('Nueva evidencia')).onclick=()=>{applyMode('evaluacion',false);openSection('cuaderno');evidenceModal()};
  topButtons.find(b=>b.textContent.includes('Crear situación')).onclick=()=>{applyMode('diario',false);openSection('planificacion');document.querySelector('#unidad-titulo').focus()};
  document.querySelector('#generar-pdf').onclick=()=>window.print();
  document.querySelector('#backup-interno').onclick=async()=>{if(!nativeMode)return toast('Disponible en la aplicación Mac.');try{const id=await nativeInvoke('create_backup');toast('Copia interna creada · #'+id)}catch(err){toast('No se pudo crear la copia interna')}};
  document.querySelector('#exportar-datos').onclick=()=>{const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='MiCuadernoDigital_v0.3_backup_'+today()+'.json';a.click();URL.revokeObjectURL(a.href);toast('Copia exportada')};
  document.querySelector('#importar-datos').onclick=()=>document.querySelector('#archivo-importar').click();
  document.querySelector('#archivo-importar').onchange=e=>{const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{const imported=JSON.parse(r.result);if(!Array.isArray(imported.students))throw new Error();data=imported;save('Copia importada correctamente')}catch(err){toast('El archivo no es una copia válida')}};r.readAsText(f)};
  document.querySelector('#restablecer-datos').onclick=()=>{if(confirm('¿Restablecer la demo? Se borrarán los datos guardados de esta instalación.')){data=clone(demo);save('Datos demo restablecidos');applyMode('diario',true)}};
  document.querySelectorAll('[data-dashboard]').forEach(card=>{card.onclick=()=>dashboardDetails(card.dataset.dashboard);card.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();dashboardDetails(card.dataset.dashboard)}}});
  document.querySelector('#timetable-add-row').onclick=addTimetableRow;
  document.querySelector('#timetable-reset').onclick=resetTimetable;
  document.querySelector('#issue-add').onclick=addIssue;
  document.querySelector('#issue-filter').onchange=renderIssues;
  document.querySelector('#google-connect').onclick=connectGoogle;
  document.querySelector('#google-sync-now').onclick=()=>syncGoogleAgenda(false);
  document.querySelector('#google-disconnect').onclick=disconnectGoogle;
  document.querySelector('#google-auto-sync').onchange=e=>{googleSettings().autoSync=e.target.checked;persistState();if(e.target.checked)scheduleGoogleAgendaSync()};
  document.querySelector('#google-duration').onchange=e=>{googleSettings().defaultDuration=Number(e.target.value)||30;persistState();scheduleGoogleAgendaSync()};
  document.querySelector('#update-check').onclick=checkAppUpdate;
  document.querySelector('#update-install').onclick=installAppUpdate;

  await hydrateFromDatabase();
  await refreshGoogleStatus();
  migrateAllGrades();
  syncCurricularEvidenceColumns();
  persistState();
  resetMeetingForm();resetActuationForm();bindRichEditors();renderAll(); applyMode('diario',false); openSection('inicio');
  updateDbStatus(nativeMode,nativeMode?'Base de datos local preparada.':'La app empaquetada usará SQLite local.');
  setInterval(()=>{renderLiveClass();renderDashboard();const u=selectedUnit();if(u)renderSessions(u)},30000);
})();
</script>
