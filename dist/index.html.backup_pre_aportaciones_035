  function gradeCountsForStudent(sid,columns=data.evidenceColumns){
    const vals=columns.map(c=>migrateGradeValue(data.evidence?.[sid]?.[c.id]||'—'));
    return {INS:vals.filter(v=>v==='INS').length,SUF:vals.filter(v=>v==='SUF').length,BI:vals.filter(v=>v==='BI').length,NOT:vals.filter(v=>v==='NOT').length,SOBRE:vals.filter(v=>v==='SOBRE').length,empty:vals.filter(v=>v==='—').length,total:vals.length}
  }
