    .participant-status.present{background:var(--green-soft);color:#166534}.participant-status.absent{background:var(--red-soft);color:#991b1b}
    .participant-add{display:flex;gap:8px;margin-top:10px}.participant-add input{flex:1}
    @media(max-width:700px){.participant-grid{grid-template-columns:1fr}}
    .dashboard-card{cursor:pointer;transition:transform .15s ease,box-shadow .15s ease,border-color .15s ease}
    .dashboard-card:hover{transform:translateY(-2px);border-color:#bfdbfe;box-shadow:0 18px 42px rgba(15,23,42,.12)}
    .dashboard-card .metric{pointer-events:none}
    .dashboard-detail{margin-top:18px}
    .dashboard-detail .mini-item{cursor:pointer}
    .dashboard-detail .mini-item:hover{background:#eff6ff}
    .timetable-wrap{overflow:auto;margin-top:12px}
    .timetable{min-width:900px;table-layout:fixed}
    .timetable th:first-child{width:120px}
    .timetable td{padding:7px}
    .timetable input{min-height:58px;border-radius:10px;font-size:13px;padding:8px}
    .timetable .time-slot{font-weight:900;color:#475569;background:#f8fafc;text-align:center}
    .timetable-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
    /* v34 · UP/Situaciones como centro de planificación */
    .planning-layout{display:grid;grid-template-columns:minmax(300px,.85fr) minmax(0,1.65fr);gap:18px;align-items:start}
    .unit-card{border:1px solid var(--line);border-radius:14px;padding:14px;background:#fff;margin-top:10px}
    .unit-card.active{border-color:#93c5fd;background:#eff6ff}
    .unit-card .unit-meta{font-size:12px;color:var(--muted);margin:5px 0 10px}
    .unit-card-actions{display:flex;gap:7px;flex-wrap:wrap}
    .unit-card-actions button{padding:7px 10px}
    .unit-editor details{border:1px solid var(--line);border-radius:14px;background:#fff;margin-top:12px;overflow:hidden}
    .unit-editor summary{cursor:pointer;font-weight:900;padding:14px 16px;background:#f8fafc;user-select:none}
    .unit-editor details>div{padding:16px}
    .full-span{grid-column:1/-1}
    .session-form{padding:14px;border:1px solid #bfdbfe;background:#eff6ff;border-radius:14px;margin-top:12px}
    .session-card{border:1px solid var(--line);border-radius:14px;padding:14px;background:#fff;margin-top:10px}
    .session-card.current{outline:3px solid rgba(22,163,74,.22);border-color:#86efac}
    .session-card.next{outline:3px solid rgba(37,99,235,.15);border-color:#93c5fd}
    .session-card-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}
    .session-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}
    .live-class{margin-top:18px;border:1px solid #93c5fd;background:linear-gradient(135deg,#eff6ff,#f8fafc);border-radius:18px;padding:18px;display:grid;grid-template-columns:1fr auto;gap:18px;align-items:center}
    .live-class.now{border-color:#86efac;background:linear-gradient(135deg,#f0fdf4,#f8fafc)}
    .live-label{font-size:12px;text-transform:uppercase;letter-spacing:.08em;font-weight:900;color:#1d4ed8}
    .live-class.now .live-label{color:#166534}
    .live-class h3{margin:5px 0 6px}
    .live-class p{margin:0;color:var(--muted);line-height:1.45}
    .cal-day.sessionday{box-shadow:inset 0 0 0 2px rgba(37,99,235,.18)}
    .cal-tag.session{color:#1d4ed8;cursor:pointer}
    .curriculum-hint{font-size:12px;color:var(--muted);margin-top:6px}
    .planning-empty{padding:28px;text-align:center;color:var(--muted)}
    @media(max-width:1100px){.planning-layout{grid-template-columns:1fr}.live-class{grid-template-columns:1fr}}
    @media print{aside,.topbar,.no-print{display:none!important}.app{display:block}.section{display:none!important}.section.active{display:block!important}main{padding:0}.card{box-shadow:none;break-inside:avoid}}

  
    /* v34 · trama curricular conectada */
    .curricular-builder{display:grid;gap:14px}
    .curricular-row{border:1px solid var(--line);border-radius:14px;padding:14px;background:#f8fafc}
    .curricular-row-grid{display:grid;grid-template-columns:140px 1fr 160px 1fr;gap:10px;align-items:end}
    .curricular-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
    .criterion-chip{display:flex;gap:10px;align-items:flex-start;justify-content:space-between;border:1px solid var(--line);border-radius:12px;padding:11px;background:white;margin-top:8px}
    .criterion-chip .mapline{font-size:12px;color:var(--muted);margin-top:4px}
    .product-card{border:1px solid var(--line);border-radius:16px;padding:14px;background:white;margin-top:10px}
    .product-card h4{margin:0 0 8px}
    .check-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
    .check-item{display:flex;gap:8px;align-items:flex-start;border:1px solid var(--line);border-radius:10px;padding:9px;background:#f8fafc;font-size:13px}
    .check-item input{width:auto;margin-top:2px}
    .curriculum-trace{font-size:12px;color:var(--muted);line-height:1.45}
    .notebook-source{display:block;font-size:11px;color:var(--muted);margin-top:4px;font-weight:600}
    @media(max-width:900px){.curricular-row-grid,.check-grid{grid-template-columns:1fr}}


    /* v34 · banco curricular Asturias + escala oficial adaptada */
    .grade-ins,.g-ins{background:#fee2e2!important;color:#991b1b!important;border-color:#fecaca!important}
    .grade-suf,.g-suf{background:#ffedd5!important;color:#9a3412!important;border-color:#fed7aa!important}
    .grade-bi,.g-bi{background:#fef9c3!important;color:#854d0e!important;border-color:#fde68a!important}
    .grade-not,.g-not{background:#dbeafe!important;color:#1d4ed8!important;border-color:#bfdbfe!important}
    .grade-sobre,.g-sobre{background:#dcfce7!important;color:#166534!important;border-color:#bbf7d0!important}
    .grade-dot.grade-ins{background:#dc2626}
    .grade-dot.grade-suf{background:#ea580c}
    .grade-dot.grade-bi{background:#ca8a04}
    .grade-dot.grade-not{background:#2563eb}
    .grade-dot.grade-sobre{background:#16a34a}

    .curriculum-picker-shell{border:1px solid var(--line);border-radius:16px;background:white;padding:16px;margin-bottom:14px}
    .curriculum-picker-head{display:grid;grid-template-columns:180px 1fr;gap:12px;align-items:end}
    .curriculum-bank-list{display:grid;gap:10px;margin-top:14px;max-height:460px;overflow:auto;padding-right:4px}
    .curriculum-bank-item{display:grid;grid-template-columns:auto 1fr;gap:10px;border:1px solid var(--line);border-radius:13px;padding:12px;background:#f8fafc}
    .curriculum-bank-item input{width:auto;margin-top:3px}
    .curriculum-bank-item strong{display:block}
    .curriculum-bank-item .ce-title{font-size:12px;font-weight:800;color:#1d4ed8;margin:4px 0}
    .curriculum-bank-item .desc{font-size:12px;color:var(--muted);line-height:1.4}
    .curriculum-bank-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
    .curriculum-source{font-size:12px;color:var(--muted);margin-top:10px;line-height:1.45}
    @media(max-width:760px){.curriculum-picker-head{grid-template-columns:1fr}}


    /* v34 · ficha de tutoría familiar */
    .tutoring-shell{display:grid;gap:18px;margin-top:18px}
    .tutoring-hero{display:grid;grid-template-columns:1.25fr .75fr;gap:18px}
    .tutoring-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
    .tutoring-kpi{border:1px solid var(--line);border-radius:14px;padding:12px;background:#f8fafc}
    .tutoring-kpi strong{font-size:24px;display:block}
    .tutoring-kpi span{font-size:12px;color:var(--muted)}
    .tutor-section{border:1px solid var(--line);border-radius:16px;padding:16px;background:white}
    .tutor-section h4{margin:0 0 10px;font-size:17px}
    .tutor-list{display:grid;gap:8px}
    .tutor-item{border:1px solid var(--line);border-radius:12px;padding:10px;background:#f8fafc}
    .tutor-item strong{display:block;margin-bottom:3px}
    .tutor-date{font-size:12px;color:var(--muted);font-weight:800}
    .tutor-grade-row{display:grid;grid-template-columns:minmax(200px,1fr) auto;gap:10px;align-items:center;border-bottom:1px solid var(--line);padding:9px 0}
    .tutor-grade-row:last-child{border-bottom:0}
    .tutor-grade{min-width:72px;text-align:center;border-radius:10px;padding:7px 10px;font-weight:900}
    .tutoring-two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
    .family-script{background:#eff6ff;border:1px solid #bfdbfe;border-radius:16px;padding:16px;line-height:1.55}
    .family-script p{margin:0 0 10px}
    .family-script p:last-child{margin-bottom:0}
    @media(max-width:900px){.tutoring-hero,.tutoring-two,.tutoring-kpis{grid-template-columns:1fr}}


    /* Escritorio · incidencias y estado de datos */
    .issue-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
    .issue-list{display:grid;gap:10px;margin-top:14px}
    .issue-item{border:1px solid var(--line);border-radius:14px;padding:13px;background:#f8fafc}
    .issue-item.resolved{opacity:.68}
    .issue-head{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;flex-wrap:wrap}
    .issue-meta{font-size:12px;color:var(--muted);margin-top:5px}
    .issue-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}
    .issue-actions button{padding:7px 10px;border-radius:9px}
    .native-status{display:flex;align-items:center;gap:9px;padding:11px 13px;border:1px solid var(--line);border-radius:12px;background:#f8fafc;margin-top:10px}
    .native-dot{width:10px;height:10px;border-radius:50%;background:#94a3b8;flex:0 0 auto}
    .native-status.ok .native-dot{background:#16a34a}
    .native-status.warn .native-dot{background:#ca8a04}
    @media(max-width:800px){.issue-grid{grid-template-columns:1fr}}


    /* Google Calendar · sincronización de Mi agenda */
    .google-card{border:1px solid #bfdbfe;background:linear-gradient(180deg,#fff,#f8fbff)}
    .google-head{display:flex;justify-content:space-between;gap:14px;align-items:flex-start;flex-wrap:wrap}
    .google-status{display:inline-flex;align-items:center;gap:8px;padding:7px 11px;border-radius:999px;font-weight:800;font-size:13px;background:#f1f5f9;color:#475569}
    .google-status.connected{background:#dcfce7;color:#166534}.google-status.error{background:#fee2e2;color:#991b1b}
    .google-dot{width:9px;height:9px;border-radius:50%;background:currentColor;display:inline-block}
    .google-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:16px;margin-top:14px}
    .google-colors{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin-top:10px}
    .google-color-row{display:grid;grid-template-columns:120px 1fr;gap:8px;align-items:center;border:1px solid var(--line);border-radius:11px;padding:8px;background:#fff}
    .google-color-row strong{font-size:13px}
    .privacy-note{border:1px solid #bbf7d0;background:#f0fdf4;border-radius:13px;padding:11px;font-size:13px;color:#166534;line-height:1.45}
    .google-last-sync{font-size:12px;color:var(--muted);margin-top:8px}
    @media(max-width:850px){.google-grid,.google-colors{grid-template-columns:1fr}}


    /* v0.3.4 · Actuaciones + editor enriquecido + updater */
    .rich-editor{border:1px solid var(--line);border-radius:13px;background:white;overflow:hidden}
    .rich-toolbar{display:flex;gap:5px;flex-wrap:wrap;padding:8px;border-bottom:1px solid var(--line);background:#f8fafc;position:sticky;top:0;z-index:1}
    .rich-toolbar button{border:1px solid var(--line);background:#fff;border-radius:8px;padding:6px 9px;font-weight:800;cursor:pointer;min-width:34px}
    .rich-toolbar button:hover{background:#eef2ff}
    .rich-area{min-height:130px;padding:12px;outline:none;line-height:1.5;white-space:normal}
    .rich-area:empty:before{content:attr(data-placeholder);color:#94a3b8;pointer-events:none}
    .rich-area ul,.rich-area ol,.rich-output ul,.rich-output ol{padding-left:24px;margin:8px 0}
    .rich-area blockquote,.rich-output blockquote{border-left:3px solid #cbd5e1;margin:8px 0;padding:6px 10px;color:#475569}
    .rich-output{line-height:1.55}.rich-output p{margin:6px 0}.rich-output h3{margin:8px 0 4px;font-size:16px}
    .actuation-list{display:grid;gap:14px}.actuation-card{border:1px solid var(--line);border-radius:16px;background:#fff;padding:16px}
    .actuation-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap}
    .actuation-meta{font-size:12px;color:var(--muted);margin-top:5px}.actuation-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
    .actuation-section{margin-top:12px;padding-top:12px;border-top:1px solid var(--line)}
    .actuation-filters{display:flex;gap:10px;align-items:end;flex-wrap:wrap;margin-bottom:12px}
    .update-card{border:1px solid #c7d2fe;background:linear-gradient(180deg,#fff,#f7f8ff)}
    .update-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap}
    .update-state{display:inline-flex;align-items:center;gap:7px;border-radius:999px;padding:7px 11px;font-size:13px;font-weight:900;background:#eef2ff;color:#3730a3}
    .update-state.ok{background:#dcfce7;color:#166534}.update-state.warn{background:#fef3c7;color:#92400e}.update-state.error{background:#fee2e2;color:#991b1b}
    .update-notes{white-space:pre-wrap;font-size:13px;color:var(--muted);margin-top:10px}
    @media(max-width:900px){.actuation-grid{grid-template-columns:1fr}}

</style>
</head>

<body>
<div class="app">
  <aside>
    <div class="brand">
      <h1>MiCuadernoDigital</h1>
      <p>v0.3.4 · Diario + Evaluación + Calendario + Actuaciones</p>
    </div>

    <div class="mode-switch">
      <button class="active" data-mode="diario">☀️ Diario</button>
      <button data-mode="evaluacion">📊 Evaluación</button>
    </div>
    <div class="mode-badge" id="mode-label">Modo Diario</div>

    <nav>
      <button class="active" data-section="inicio">Inicio</button>
      <button data-section="agenda">Mi agenda</button>
      <button data-section="reuniones">Reuniones</button>
      <button data-section="actuaciones">Actuaciones</button>
      <button data-section="cuaderno">Cuaderno de notas</button>
      <button data-section="alumnado">Alumnado</button>
      <button data-section="diario">Diario</button>
      <button data-section="asistencia">Asistencia</button>
      <button data-section="planificacion">UP / Situaciones</button>
      <button data-section="perfil">Perfil competencial</button>
      <button data-section="mapa">Mapa aprendizaje</button>
      <button data-section="desarrollo">Inteligencia pedagógica</button>
      <button data-section="configuracion">Configuración</button>
      <button data-section="pdf">PDF oficial</button>
    </nav>

    <div class="sidebar-note">
      <strong>Idea clave:</strong><br>
      La programación, la evaluación y el día a día de clase son la misma cosa vista desde perspectivas diferentes.
    </div>
  </aside>

  <main>
    <header class="topbar">
      <div>
        <h2 id="page-title">Inicio</h2>
        <p id="page-subtitle">Vista diaria rápida para trabajar con el grupo sin burocracia.</p>
      </div>
      <div class="actions">
        <button class="ghost">Nueva observación</button>
        <button class="secondary">Nueva evidencia</button>
        <button class="primary">Crear situación</button>
      </div>
    </header>

    <section id="inicio" class="section active">
      <div class="grid cols-4">
        <div class="card dashboard-card" data-dashboard="sessions" tabindex="0">
          <h3>Sesiones de hoy</h3>
          <div class="metric"><div><strong id="dash-sessions-count">0</strong><br><span>vinculadas para hoy</span></div><span>☀️</span></div>
        </div>
        <div class="card dashboard-card" data-dashboard="absent" tabindex="0">
          <h3>Alumnado ausente</h3>
          <div class="metric"><div><strong id="dash-absent-count">0</strong><br><span>faltas registradas hoy</span></div><span>🟡</span></div>
        </div>
        <div class="card dashboard-card" data-dashboard="evidence" tabindex="0">
          <h3>Evidencias pendientes</h3>
          <div class="metric"><div><strong id="dash-evidence-count">0</strong><br><span>registros sin completar</span></div><span>📌</span></div>
        </div>
        <div class="card dashboard-card" data-dashboard="alerts" tabindex="0">
          <h3>Alertas</h3>
          <div class="metric"><div><strong id="dash-alert-count">0</strong><br><span>requieren una mirada</span></div><span>⚠️</span></div>
        </div>
      </div>

      <div id="live-class-panel" class="live-class">
        <div>
          <div class="live-label">Ahora / a continuación</div>
          <h3 id="live-class-title">Sin sesión programada en este momento</h3>
          <p id="live-class-detail">Cuando programes fecha y hora en una sesión, aparecerá aquí automáticamente.</p>
        </div>
        <button class="primary hidden" id="live-class-open">Abrir sesión</button>
      </div>

      <div class="card" style="margin-top:18px">
        <h3>Resumen pedagógico del día</h3>
        <p id="daily-summary">El resumen se actualiza con la asistencia, las evidencias y el seguimiento registrado.</p>
        <div id="daily-summary-pills"></div>
      </div>
    </section>

    <section id="cuaderno" class="section">
      <div class="card notebook-header">
        <div class="notebook-title-row">
          <div>
            <h3>Cuaderno de evaluación</h3>
            <p>Evalúa los criterios a través de los productos de tus situaciones. La trama curricular se actualiza por detrás.</p>
          </div>
          <button class="primary no-print" id="nueva-evidencia-local">＋ Evidencia manual</button>
        </div>

        <div class="notebook-stats" id="notebook-stats"></div>

        <div class="notebook-view-switch no-print" id="notebook-view-switch">
          <button class="active" data-notebook-view="matrix">▦ Matriz del grupo</button>
          <button data-notebook-view="student">👤 Foco alumno</button>
          <button data-notebook-view="evidence">◎ Foco evidencia</button>
        </div>

        <div class="notebook-toolbar no-print">
          <label class="notebook-search">Buscar alumno/a
            <input id="notebook-search" type="search" placeholder="Escribe un nombre...">
          </label>
          <label>Competencia
            <select id="notebook-competency"><option value="all">Todas</option></select>
          </label>
          <label id="notebook-evidence-filter-wrap">Evidencia
            <select id="notebook-evidence-filter"><option value="all">Todas</option></select>
          </label>
        </div>

        <div class="notebook-legend">
          <span><i class="grade-dot grade-empty"></i> Sin registrar</span>
          <span><i class="grade-dot grade-ins"></i> INS · Insuficiente</span>
          <span><i class="grade-dot grade-suf"></i> SUF · Suficiente</span>
          <span><i class="grade-dot grade-bi"></i> BI · Bien</span>
          <span><i class="grade-dot grade-not"></i> NOT · Notable</span>
          <span><i class="grade-dot grade-sobre"></i> SOBRE · Sobresaliente</span>
          <span class="small">En la matriz, pulsa una celda para avanzar de nivel.</span>
        </div>
      </div>

      <div id="notebook-matrix" class="notebook-view"></div>
      <div id="notebook-student-focus" class="notebook-view hidden"></div>
      <div id="notebook-evidence-focus" class="notebook-view hidden"></div>
    </section>

    <section id="alumnado" class="section">
      <div class="card no-print" style="margin-bottom:18px">
        <h3>Gestión del alumnado</h3>
        <div id="student-chips"></div>
        <div class="actions" style="justify-content:flex-start;margin-top:12px">
          <button class="primary" id="nuevo-alumno">Añadir alumno/a</button>
          <button class="ghost" id="editar-alumno">Editar seleccionado</button>
          <button class="ghost danger" id="eliminar-alumno" onclick="alert('BOTON BORRAR FUNCIONA')">Eliminar seleccionado</button>
        </div>
      </div>
      <div class="student-panel">
        <div class="card">
          <div class="avatar">C</div>
          <h3>Claudia</h3>
          <p>Expediente pedagógico vivo.</p>
