<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>MiCuadernoDigital v34</title>
  <style>
    :root{
      --bg:#f5f7fb;
      --panel:#ffffff;
      --text:#1f2937;
      --muted:#6b7280;
      --line:#e5e7eb;
      --primary:#2563eb;
      --primary-soft:#dbeafe;
      --green:#16a34a;
      --green-soft:#dcfce7;
      --yellow:#ca8a04;
      --yellow-soft:#fef9c3;
      --red:#dc2626;
      --red-soft:#fee2e2;
      --purple:#7c3aed;
      --purple-soft:#ede9fe;
      --shadow:0 14px 35px rgba(15,23,42,.08);
      --radius:18px;
    }

    *{box-sizing:border-box}

    body{
      margin:0;
      font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
      background:var(--bg);
      color:var(--text);
    }

    .app{
      display:grid;
      grid-template-columns:280px 1fr;
      min-height:100vh;
    }

    aside{
      background:#0f172a;
      color:white;
      padding:22px;
      position:sticky;
      top:0;
      height:100vh;
      overflow:auto;
    }

    .brand{
      margin-bottom:28px;
    }

    .brand h1{
      font-size:23px;
      margin:0;
      letter-spacing:-.03em;
    }

    .brand p{
      margin:6px 0 0;
      color:#cbd5e1;
      font-size:14px;
    }

    .mode-switch{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:8px;
      background:#1e293b;
      padding:6px;
      border-radius:14px;
      margin-bottom:22px;
    }

    .mode-switch button{
      border:0;
      border-radius:10px;
      padding:9px;
      cursor:pointer;
      color:#cbd5e1;
      background:transparent;
      font-weight:700;
    }

    .mode-switch button.active{
      background:white;
      color:#0f172a;
    }

    nav{
      display:flex;
      flex-direction:column;
      gap:6px;
    }

    nav button{
      border:0;
      background:transparent;
      color:#dbeafe;
      text-align:left;
      padding:12px 12px;
      border-radius:12px;
      cursor:pointer;
      font-size:15px;
    }

    nav button:hover,
    nav button.active{
      background:#1d4ed8;
      color:#fff;
    }

    .sidebar-note{
      margin-top:22px;
      border:1px solid rgba(255,255,255,.12);
      background:rgba(255,255,255,.06);
      border-radius:16px;
      padding:14px;
      font-size:13px;
      color:#cbd5e1;
      line-height:1.4;
    }

    main{
      padding:28px;
      overflow:hidden;
    }

    .topbar{
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap:20px;
      margin-bottom:22px;
    }

    .topbar h2{
      margin:0;
      font-size:34px;
      letter-spacing:-.04em;
    }

    .topbar p{
      margin:7px 0 0;
      color:var(--muted);
      max-width:820px;
      line-height:1.45;
    }

    .actions{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      justify-content:flex-end;
    }

    button.primary,
    button.secondary,
    button.ghost{
      border:0;
      border-radius:12px;
      padding:11px 15px;
      cursor:pointer;
      font-weight:800;
      white-space:nowrap;
    }

    button.primary{
      background:var(--primary);
      color:white;
    }

    button.secondary{
      background:var(--primary-soft);
      color:#1d4ed8;
    }

    button.ghost{
      background:white;
      border:1px solid var(--line);
      color:var(--text);
    }

    .section{display:none}
    .section.active{display:block}

    .grid{
      display:grid;
      gap:18px;
    }

    .grid.cols-2{grid-template-columns:repeat(2,minmax(0,1fr))}
    .grid.cols-3{grid-template-columns:repeat(3,minmax(0,1fr))}
    .grid.cols-4{grid-template-columns:repeat(4,minmax(0,1fr))}

    .card{
      background:var(--panel);
      border:1px solid var(--line);
      border-radius:var(--radius);
      box-shadow:var(--shadow);
      padding:20px;
    }

    .card h3{
      margin:0 0 12px;
      font-size:20px;
      letter-spacing:-.02em;
    }

    .card p{
      color:var(--muted);
      line-height:1.5;
      margin:0 0 12px;
    }

    .metric{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:14px;
      padding:14px;
      background:#f8fafc;
      border:1px solid var(--line);
      border-radius:14px;
      margin-top:10px;
    }

    .metric strong{font-size:24px}
    .metric span{color:var(--muted);font-size:13px}

    .pill{
      display:inline-flex;
      align-items:center;
      gap:6px;
      padding:6px 10px;
      border-radius:999px;
      font-size:13px;
      font-weight:800;
      margin:4px 4px 4px 0;
    }

    .pill.green{background:var(--green-soft);color:#166534}
    .pill.yellow{background:var(--yellow-soft);color:#854d0e}
    .pill.red{background:var(--red-soft);color:#991b1b}
    .pill.blue{background:var(--primary-soft);color:#1d4ed8}
    .pill.purple{background:var(--purple-soft);color:#5b21b6}

    table{
      width:100%;
      border-collapse:separate;
      border-spacing:0;
      overflow:hidden;
      border:1px solid var(--line);
      border-radius:14px;
      background:white;
    }

    th,td{
      padding:13px 14px;
      border-bottom:1px solid var(--line);
      text-align:left;
      font-size:14px;
      vertical-align:middle;
    }

    th{
      background:#f8fafc;
      color:#475569;
      font-size:13px;
      text-transform:uppercase;
      letter-spacing:.04em;
    }

    tr:last-child td{border-bottom:0}

    .student-row{
      cursor:pointer;
    }

    .student-row:hover{
      background:#f8fafc;
    }

    .evidence-cell{
      border-radius:10px;
      background:var(--green-soft);
      color:#166534;
      font-weight:800;
      display:inline-block;
      padding:7px 9px;
      min-width:44px;
      text-align:center;
    }

    .evidence-cell.mid{
      background:var(--yellow-soft);
      color:#854d0e;
    }

    .evidence-cell.low{
      background:var(--red-soft);
      color:#991b1b;
    }

    .tabs{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
      margin-bottom:16px;
    }

    .tabs button{
      border:1px solid var(--line);
      background:white;
      padding:10px 13px;
      border-radius:999px;
      cursor:pointer;
      font-weight:800;
    }

    .tabs button.active{
      background:#0f172a;
      color:white;
      border-color:#0f172a;
    }

    .student-panel{
      display:grid;
      grid-template-columns:320px 1fr;
      gap:18px;
    }

    .avatar{
      width:78px;
      height:78px;
      border-radius:24px;
      background:linear-gradient(135deg,#dbeafe,#ede9fe);
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:31px;
      font-weight:900;
      color:#1d4ed8;
      margin-bottom:12px;
    }

    .timeline{
      position:relative;
      display:flex;
      flex-direction:column;
      gap:12px;
      margin-top:10px;
    }

    .timeline-item{
      display:grid;
      grid-template-columns:110px 1fr;
      gap:14px;
      padding:13px;
      background:#f8fafc;
      border:1px solid var(--line);
      border-radius:14px;
    }

    .timeline-item time{
      color:var(--muted);
      font-size:13px;
      font-weight:800;
    }

    .timeline-item strong{
      display:block;
      margin-bottom:4px;
    }

    .progress-line{
      height:12px;
      background:#e5e7eb;
      border-radius:999px;
      overflow:hidden;
      margin:8px 0 14px;
    }

    .progress-line div{
      height:100%;
      background:#2563eb;
      border-radius:999px;
    }

    .calendar{
      display:grid;
      grid-template-columns:repeat(7,1fr);
      gap:8px;
    }

    .day{
      min-height:78px;
      background:#f8fafc;
      border:1px solid var(--line);
      border-radius:12px;
      padding:8px;
      font-size:13px;
      color:#475569;
    }

    .day.holiday{background:var(--red-soft);color:#991b1b}
    .day.schoolfree{background:var(--yellow-soft);color:#854d0e}
    .day.absent{outline:3px solid rgba(220,38,38,.2)}
    .day.late{outline:3px solid rgba(202,138,4,.25)}

    .form-grid{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:14px;
    }

    label{
      display:flex;
      flex-direction:column;
      gap:6px;
      font-weight:800;
      font-size:13px;
      color:#475569;
    }

    input,select,textarea{
      width:100%;
      border:1px solid var(--line);
      border-radius:12px;
      padding:11px 12px;
      font:inherit;
      background:white;
      color:var(--text);
    }

    textarea{min-height:110px;resize:vertical}

    .path{
      display:grid;
      gap:10px;
    }

    .path div{
      background:#f8fafc;
      border:1px solid var(--line);
      border-radius:14px;
      padding:13px;
      font-weight:800;
    }

    .arrow{
      text-align:center;
      color:var(--muted);
      font-weight:900;
    }

    .map{
      display:grid;
      grid-template-columns:repeat(10,1fr);
      gap:8px;
      align-items:end;
      height:210px;
      padding-top:20px;
    }

    .bar{
      border-radius:12px 12px 4px 4px;
      background:#dbeafe;
      border:1px solid #bfdbfe;
      display:flex;
      align-items:flex-end;
      justify-content:center;
      padding-bottom:6px;
      color:#1d4ed8;
      font-weight:900;
      font-size:12px;
    }

    .official-pdf{
      border:2px dashed #bfdbfe;
      background:#eff6ff;
    }

    .interpretation{
      display:none;
      background:#f8fafc;
      border:1px solid var(--line);
      border-radius:16px;
      padding:16px;
      margin-top:14px;
      line-height:1.55;
    }

    .interpretation.show{display:block}

    .small{
      font-size:13px;
      color:var(--muted);
      line-height:1.45;
    }



    /* Cuaderno de evaluación v34 */
    .notebook-header{margin-bottom:18px}
    .notebook-title-row{display:flex;align-items:flex-start;justify-content:space-between;gap:18px}
    .notebook-title-row h3{margin-bottom:5px}
    .notebook-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:16px 0}
    .notebook-stat{padding:13px 14px;border:1px solid var(--line);border-radius:14px;background:#f8fafc}
    .notebook-stat strong{display:block;font-size:24px;line-height:1.05;margin-bottom:4px}
    .notebook-stat span{font-size:12px;color:var(--muted);font-weight:700}
    .notebook-view-switch{display:flex;gap:8px;flex-wrap:wrap;margin:4px 0 14px}
    .notebook-view-switch button{border:1px solid var(--line);background:white;padding:9px 13px;border-radius:999px;cursor:pointer;font-weight:800;color:#475569}
    .notebook-view-switch button.active{background:#0f172a;color:white;border-color:#0f172a}
    .notebook-toolbar{display:grid;grid-template-columns:minmax(220px,1.5fr) minmax(170px,.7fr) minmax(220px,1fr);gap:10px;align-items:end}
    .notebook-legend{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-top:14px;padding-top:13px;border-top:1px solid var(--line);font-size:12px;color:#475569;font-weight:700}
    .grade-dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:5px;vertical-align:-1px;border:1px solid rgba(15,23,42,.12)}
    .grade-empty{background:#f1f5f9}.grade-ep{background:#fee2e2}.grade-i{background:#fef9c3}.grade-a{background:#dcfce7}
    .notebook-table-card{padding:0;overflow:hidden}
    .notebook-table-scroll{overflow:auto;max-height:68vh;border-radius:var(--radius)}
    .notebook-table{border:0;border-radius:0;min-width:850px}
    .notebook-table th{position:sticky;top:0;z-index:4;background:#f8fafc;box-shadow:0 1px 0 var(--line)}
    .notebook-table th:first-child,.notebook-table td:first-child{position:sticky;left:0;z-index:3;background:white;min-width:190px;box-shadow:1px 0 0 var(--line)}
    .notebook-table th:first-child{z-index:6;background:#f8fafc}
    .notebook-table tbody tr:hover td{background:#f8fafc}
    .notebook-table tbody tr:hover td:first-child{background:#f8fafc}
    .evidence-head{min-width:145px;max-width:190px;cursor:pointer;text-transform:none;letter-spacing:0}
    .evidence-head strong{display:block;color:#0f172a;font-size:13px;line-height:1.25}
    .evidence-head span{display:block;margin-top:4px;font-size:11px;color:var(--muted);font-weight:700}
    .student-name-cell{cursor:pointer}
    .student-name-cell strong{font-size:14px}
    .student-row-summary{display:flex;gap:4px;margin-top:6px;flex-wrap:wrap}
    .tiny-grade{font-size:10px;font-weight:900;padding:2px 6px;border-radius:999px}
    .tiny-grade.a{background:var(--green-soft);color:#166534}.tiny-grade.i{background:var(--yellow-soft);color:#854d0e}.tiny-grade.ep{background:var(--red-soft);color:#991b1b}.tiny-grade.empty{background:#f1f5f9;color:#64748b}
    .notebook-grade{width:48px;height:40px;border-radius:11px;border:1px solid transparent;cursor:pointer;font-weight:900;font-size:13px;transition:transform .08s ease,box-shadow .12s ease}
    .notebook-grade:hover{transform:translateY(-1px);box-shadow:0 5px 14px rgba(15,23,42,.1)}
    .notebook-grade.g-empty{background:#f1f5f9;color:#64748b;border-color:#e2e8f0}.notebook-grade.g-ep{background:var(--red-soft);color:#991b1b;border-color:#fecaca}.notebook-grade.g-i{background:var(--yellow-soft);color:#854d0e;border-color:#fde68a}.notebook-grade.g-a{background:var(--green-soft);color:#166534;border-color:#bbf7d0}
    .focus-layout{display:grid;grid-template-columns:280px 1fr;gap:18px}
    .focus-sidebar{position:sticky;top:18px;align-self:start}
    .focus-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:14px}
    .focus-summary div{padding:10px;border-radius:12px;text-align:center;background:#f8fafc;border:1px solid var(--line)}
    .focus-summary strong{display:block;font-size:20px}.focus-summary span{font-size:10px;color:var(--muted);font-weight:800}
    .evidence-card-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
    .evidence-focus-card{border:1px solid var(--line);border-radius:16px;padding:15px;background:white}
    .evidence-focus-card h4{margin:0 0 5px;font-size:15px}.evidence-focus-card .meta{font-size:11px;color:var(--muted);font-weight:700;margin-bottom:11px}
    .grade-choice-row{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
    .grade-choice-row button{border:1px solid var(--line);border-radius:10px;padding:9px 5px;cursor:pointer;font-weight:900;background:#f8fafc;color:#64748b}
    .grade-choice-row button.active.g-ep,.grade-choice-row button.g-ep:hover{background:var(--red-soft);color:#991b1b;border-color:#fecaca}
    .grade-choice-row button.active.g-i,.grade-choice-row button.g-i:hover{background:var(--yellow-soft);color:#854d0e;border-color:#fde68a}
    .grade-choice-row button.active.g-a,.grade-choice-row button.g-a:hover{background:var(--green-soft);color:#166534;border-color:#bbf7d0}
    .grade-choice-row button.active.g-empty,.grade-choice-row button.g-empty:hover{background:#e2e8f0;color:#475569}
    .evidence-roster{display:flex;flex-direction:column;gap:8px}
    .evidence-roster-row{display:grid;grid-template-columns:minmax(150px,1fr) 300px;gap:14px;align-items:center;border:1px solid var(--line);border-radius:14px;padding:11px 13px;background:white}
    .evidence-roster-row .grade-choice-row{grid-template-columns:repeat(4,1fr)}
    .notebook-empty{padding:28px;text-align:center;color:var(--muted)}

    @media(max-width:1050px){
      .notebook-stats{grid-template-columns:repeat(2,1fr)}
      .notebook-toolbar,.focus-layout{grid-template-columns:1fr}
      .focus-sidebar{position:relative;top:auto}
      .evidence-card-grid{grid-template-columns:1fr}
      .evidence-roster-row{grid-template-columns:1fr}

      .app{grid-template-columns:1fr}
      aside{
        position:relative;
        height:auto;
      }
      nav{
        display:grid;
        grid-template-columns:repeat(2,minmax(0,1fr));
      }
      .grid.cols-2,.grid.cols-3,.grid.cols-4,.student-panel,.form-grid{
        grid-template-columns:1fr;
      }
      .topbar{
        flex-direction:column;
      }
    }


    /* v34 · funcionalidad */
    .hidden{display:none!important}
    .toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:end;margin:14px 0}
    .toolbar label{min-width:170px;flex:1}
    .compact-input{min-width:0}
    .notice{padding:12px 14px;border-radius:12px;background:#eff6ff;border:1px solid #bfdbfe;color:#1e40af;font-size:13px;line-height:1.45}
    .danger{background:#fee2e2!important;color:#991b1b!important}
    .success{background:#dcfce7!important;color:#166534!important}
    .student-chip{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--line);background:white;border-radius:999px;padding:8px 11px;margin:4px;cursor:pointer;font-weight:800}
    .student-chip.active{background:#0f172a;color:white;border-color:#0f172a}
    .attendance-row{display:grid;grid-template-columns:minmax(160px,1fr) repeat(3,auto);gap:8px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line)}
    .attendance-row:last-child{border-bottom:0}
    .attendance-row button{border:1px solid var(--line);background:white;border-radius:10px;padding:8px 10px;cursor:pointer;font-weight:800}
    .attendance-row button.active-present{background:#dcfce7;color:#166534;border-color:#86efac}
    .attendance-row button.active-absent{background:#fee2e2;color:#991b1b;border-color:#fca5a5}
    .attendance-row button.active-late{background:#fef9c3;color:#854d0e;border-color:#fde047}
    .toast{position:fixed;right:22px;bottom:22px;z-index:1000;background:#0f172a;color:white;padding:12px 16px;border-radius:12px;box-shadow:var(--shadow);opacity:0;transform:translateY(12px);transition:.2s;pointer-events:none;max-width:340px}
    .toast.show{opacity:1;transform:translateY(0)}
    .modal-backdrop{position:fixed;inset:0;background:rgba(15,23,42,.55);display:none;align-items:center;justify-content:center;z-index:999;padding:20px}
    .modal-backdrop.show{display:flex}
    .modal{width:min(680px,100%);max-height:88vh;overflow:auto;background:white;border-radius:20px;padding:22px;box-shadow:0 24px 80px rgba(0,0,0,.25)}
    .modal h3{margin-top:0}
    .modal-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:16px}
    .empty{padding:18px;text-align:center;color:var(--muted);border:1px dashed var(--line);border-radius:14px}
    .mini-list{display:grid;gap:9px;margin-top:12px}
    .mini-item{padding:11px 12px;border:1px solid var(--line);border-radius:12px;background:#f8fafc}
    .mini-item strong{display:block;margin-bottom:3px}
    .mode-badge{display:inline-flex;margin-top:10px;padding:6px 10px;border-radius:999px;background:#1e293b;color:#e2e8f0;font-size:12px;font-weight:800}
    .bank-category{border:0;cursor:pointer}
    .bank-category.active{outline:3px solid rgba(37,99,235,.2)}
    .suggestion-btn{display:block;width:100%;text-align:left;border:1px solid var(--line);background:#f8fafc;border-radius:12px;padding:11px 12px;margin-top:8px;cursor:pointer;color:var(--text)}
    .suggestion-btn:hover{background:#eff6ff;border-color:#bfdbfe}
    .calendar-toolbar{display:flex;gap:10px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin-bottom:14px}
    .calendar-toolbar select{width:auto;min-width:180px}
    .calendar-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:7px}
    .calendar-head{font-size:12px;font-weight:900;color:#64748b;text-align:center;padding:5px}
    .cal-day{min-height:82px;border:1px solid var(--line);border-radius:12px;padding:7px;background:#fff;position:relative;font-size:12px;overflow:hidden}
    .cal-day .num{font-weight:900;font-size:14px}
    .cal-day.other{opacity:.28}
    .cal-day.weekend{background:#f8fafc}
    .cal-day.vacation{background:#fef9c3;border-color:#fde68a}
    .cal-day.nonlective{background:#ffedd5;border-color:#fdba74}
    .cal-day.holiday{background:#fee2e2;border-color:#fca5a5}
    .cal-day.permission{background:#ede9fe;border-color:#c4b5fd}
    .cal-day.center{background:#dbeafe;border-color:#93c5fd}
    .cal-day.today{outline:3px solid rgba(37,99,235,.3)}
    .cal-tags{display:flex;flex-direction:column;gap:3px;margin-top:5px}
    .cal-tag{font-size:10px;line-height:1.15;font-weight:800}
    .legend{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.legend span{font-size:12px;padding:5px 8px;border-radius:999px;border:1px solid var(--line)}
    .agenda-item{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:start;padding:12px;border:1px solid var(--line);border-radius:14px;background:#fff}
    .agenda-item.done{opacity:.55}.agenda-item.done .agenda-text{text-decoration:line-through}
    .agenda-date{min-width:76px;font-weight:900;color:#1d4ed8}.agenda-actions{display:flex;gap:6px}.agenda-actions button{border:1px solid var(--line);background:white;border-radius:9px;padding:6px 8px;cursor:pointer}
    .meeting-list{display:grid;gap:14px}
    .meeting-card{border:1px solid var(--line);border-radius:16px;background:#fff;padding:16px}
    .meeting-head{display:flex;justify-content:space-between;gap:14px;align-items:flex-start;flex-wrap:wrap}
    .meeting-meta{color:var(--muted);font-size:13px;margin-top:4px}
    .meeting-section{margin-top:12px;padding-top:12px;border-top:1px solid var(--line)}
    .participant-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:8px}
    .participant-row{display:flex;align-items:center;justify-content:space-between;gap:8px;border:1px solid var(--line);border-radius:12px;padding:9px 10px;background:#f8fafc}
