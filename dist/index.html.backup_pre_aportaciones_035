  function studentGradeRecords(studentId){
    return (data.evidenceColumns||[]).map(c=>({
      column:c,
      grade:migrateGradeValue(data.evidence?.[studentId]?.[c.id]||'—')
    })).filter(x=>x.grade!=='—');
  }

  function gradeRank(v){return {'INS':1,'SUF':2,'BI':3,'NOT':4,'SOBRE':5}[v]||0}

  function studentCurricularSummary(studentId){
    const records=studentGradeRecords(studentId);
    const byCriterion={};
    records.forEach(r=>{
      const key=r.column.criterion||r.column.label;
      byCriterion[key]=byCriterion[key]||{label:key,text:r.column.criterionText||'',ce:r.column.specificCompetence||'',descriptors:r.column.descriptors||'',grades:[],products:[]};
      byCriterion[key].grades.push(r.grade);
      if(r.column.productName)byCriterion[key].products.push(r.column.productName);
    });
    const criteria=Object.values(byCriterion).map(x=>{
      const latest=x.grades[x.grades.length-1]||'—';
      const avg=x.grades.length?x.grades.reduce((a,v)=>a+gradeRank(v),0)/x.grades.length:0;
      return {...x,latest,avg};
    });
    return {
      records,criteria,
      strengths:[...criteria].sort((a,b)=>b.avg-a.avg).filter(x=>x.avg>=4).slice(0,4),
      needs:[...criteria].sort((a,b)=>a.avg-b.avg).filter(x=>x.avg>0&&x.avg<=2).slice(0,4)
    };
  }

  function studentObservations(studentId){
    return (data.observations||[]).filter(o=>o.studentId===studentId).sort((a,b)=>b.date.localeCompare(a.date));
  }

  function studentMeetings(st){
    const name=String(st.name||'').toLowerCase();
    return (data.meetings||[]).filter(m=>{
      if(m.studentId===st.id)return true;
      const hay=[m.title,richText(m.development),richText(m.agreements),richText(m.followup),(m.participants||[]).map(p=>p.name).join(' ')].join(' ').toLowerCase();
      return name && hay.includes(name);
    }).sort((a,b)=>(b.date+(b.start||'')).localeCompare(a.date+(a.start||'')));
  }

  function tutoringFamilyNarrative(st,cur,att,obs,meetings){
    const assessed=cur.records.length;
    const strong=cur.strengths.map(x=>x.label).slice(0,2);
    const needs=cur.needs.map(x=>x.label).slice(0,2);
    const parts=[];
    parts.push(`${st.name} cuenta actualmente con ${assessed} valoración${assessed===1?'':'es'} registrada${assessed===1?'':'s'} en el cuaderno.`);
    if(strong.length)parts.push(`Los resultados más sólidos aparecen en ${strong.join(' y ')}.`);
    if(needs.length)parts.push(`Conviene seguir acompañando especialmente ${needs.join(' y ')}.`);
    if(obs.length)parts.push(`Hay ${obs.length} observación${obs.length===1?'':'es'} individual${obs.length===1?'':'es'} registrada${obs.length===1?'':'s'}; la más reciente es del ${obs[0].date}.`);
    if(att.total)parts.push(`La asistencia registrada es del ${att.pct}%, con ${att.absences.length} falta${att.absences.length===1?'':'s'} y ${att.lates.length} retraso${att.lates.length===1?'':'s'}.`);
    if(meetings.length)parts.push(`Constan ${meetings.length} reunión${meetings.length===1?'':'es'} relacionada${meetings.length===1?'':'s'} en el historial.`);
    return parts.join(' ');
  }

