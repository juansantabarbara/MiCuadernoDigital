  function renderStudentProfile(){
    const st=student(); if(!st)return;
    const panel=document.querySelector('#alumnado .student-panel');
    const left=panel?.querySelector('.card'); if(!left)return;
    left.querySelector('.avatar').textContent=st.name.charAt(0).toUpperCase();
    left.querySelector('h3').textContent=st.name;
    const pills=left.querySelectorAll('.pill');
    if(pills[0])pills[0].textContent='↗ '+st.status;
    if(pills[1])pills[1].textContent=(st.strengths[0]||'Fortaleza');
    if(pills[2])pills[2].textContent=(st.difficulties[0]||'A reforzar');
    const metrics=left.querySelectorAll('.metric strong');
    if(metrics[0])metrics[0].textContent=(st.coverage??0)+'%';if(metrics[1])metrics[1].textContent=st.feedbacks??0;if(metrics[2])metrics[2].textContent=(st.attendance??100)+'%';
    const interp=document.querySelector('#interpretacion-alumno');
    interp.innerHTML='<strong>Lectura pedagógica automática</strong><br><br>'+esc(buildInterpretation(st));
    const dev=document.querySelector('#alumnado .student-panel .grid .card');
    if(dev){
      const cols=dev.querySelectorAll('.grid.cols-3 > div');
      if(cols[0]) cols[0].innerHTML='<h4>Fortalezas</h4>'+st.strengths.map(x=>`<span class="pill green">${esc(x)}</span>`).join('');
      if(cols[1]) cols[1].innerHTML='<h4>Dificultades</h4>'+st.difficulties.map(x=>`<span class="pill yellow">${esc(x)}</span>`).join('');
      if(cols[2]) cols[2].innerHTML='<h4>Próximos pasos</h4><p>'+esc(st.next||'Recoger nuevas evidencias y revisar la evolución.')+'</p>';
    }
    renderTimeline(st.id);
  }
  function buildInterpretation(st){
    const ev=data.evidence[st.id]||{}; const vals=Object.values(ev); const low=vals.filter(v=>migrateGradeValue(v)==='INS').length; const high=vals.filter(v=>v==='A').length;
    const trajectory=high>low?'mantiene una trayectoria global positiva':low>high?'necesita seguimiento cercano':'muestra una evolución estable';
    return `${st.name} ${trajectory}. Sus fortalezas más visibles son ${st.strengths.join(', ')||'aún por determinar'}. Conviene reforzar ${st.difficulties.join(', ')||'los criterios con menor número de evidencias'}. Próximo paso: ${st.next||'recoger nuevas evidencias variadas.'}`;
  }
  function renderTimeline(studentId){
    const box=document.querySelector('#alumnado .timeline'); if(!box)return;
    const obs=data.observations.filter(o=>o.studentId===studentId).sort((a,b)=>b.date.localeCompare(a.date));
    const atts=Object.entries(data.attendance).flatMap(([date,rec])=>rec[studentId]&&rec[studentId]!=='P'?[{date,type:'Asistencia',text:rec[studentId]==='F'?'Falta registrada':'Retraso registrado'}]:[]);
    const all=[...obs.map(o=>({date:o.date,type:o.category||'Observación',text:o.text})),...atts].sort((a,b)=>b.date.localeCompare(a.date)).slice(0,8);
    box.innerHTML=all.length?all.map(x=>`<div class="timeline-item"><time>${esc(x.date)}</time><div><strong>${esc(x.type)}</strong><span class="small">${esc(x.text)}</span></div></div>`).join(''):'<div class="empty">Todavía no hay registros para este alumno.</div>';
  }

