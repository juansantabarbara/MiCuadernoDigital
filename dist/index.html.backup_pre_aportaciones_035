    const btn=document.querySelector('#google-connect'),
          old=btn.textContent;

    btn.disabled=true;
    btn.textContent='Esperando a Google…';

    try{
      googleStatusCache=await nativeInvoke('google_connect');
      googleStatusCache.error=false;

      toast('Google Calendar conectado');

      try{
        await syncGoogleAgenda(true);
      }catch(syncErr){
        console.error('Google Calendar initial sync failed',syncErr);
        googleStatusCache.error=true;
        googleStatusCache.detail='Google Calendar está conectado, pero la sincronización inicial ha fallado.';
        toast('Google conectado, pero falló la sincronización inicial');
      }

    }catch(err){
      googleStatusCache={
        connected:false,
        error:true,
        detail:String(err)
      };
      toast('No se pudo conectar: '+String(err).slice(0,120));

    }finally{
      btn.disabled=false;
      btn.textContent=old;
      renderGoogleCalendarSettings();
    }
  }

  async function disconnectGoogle(){
    if(!nativeMode)return;if(!confirm('¿Desconectar Google Calendar? El calendario ya creado en Google no se borrará.'))return;
    try{await nativeInvoke('google_disconnect');googleStatusCache={...googleStatusCache,connected:false,detail:'Desconectado. El calendario de Google se conserva.'};toast('Google Calendar desconectado')}catch(err){toast('No se pudo desconectar')};renderGoogleCalendarSettings();
  }
  async function syncGoogleAgenda(silent=false){
    if(!nativeMode)return;
    if(!googleStatusCache.connected){if(!silent)return toast('Conecta primero Google Calendar.');return}
    try{
      const gs=googleSettings();const report=await nativeInvoke('google_sync_agenda',{agendaJson:JSON.stringify(data.agenda||[]),colorMapJson:JSON.stringify(gs.colors||{}),defaultDurationMinutes:Number(gs.defaultDuration||30)});
      googleStatusCache.last_sync_at=report.last_sync_at;googleStatusCache.error=false;renderGoogleCalendarSettings();if(!silent)toast(`Google Calendar: ${report.created} creados · ${report.updated} actualizados · ${report.deleted} eliminados`);
    }catch(err){console.error('Google Calendar sync failed',err);googleStatusCache.error=true;googleStatusCache.detail=String(err);renderGoogleCalendarSettings();if(!silent)toast('Error al sincronizar con Google Calendar')}
  }
  function scheduleGoogleAgendaSync(){
    if(!nativeMode||googleSettings().autoSync===false||!googleStatusCache.connected)return;clearTimeout(googleSyncTimer);googleSyncTimer=setTimeout(()=>syncGoogleAgenda(true),900);
  }

  function renderAgenda(){const box=document.querySelector('#agenda-list');if(!box)return;const filter=document.querySelector('#agenda-filter')?.value||'pending';let items=[...(data.agenda||[])].sort((a,b)=>(a.date+(a.time||'')).localeCompare(b.date+(b.time||'')));if(filter==='pending')items=items.filter(x=>!x.done);if(filter==='done')items=items.filter(x=>x.done);box.innerHTML=items.length?items.map(x=>`<div class="agenda-item ${x.done?'done':''}"><div class="agenda-date">${esc(x.date)}<br><span class="small">${esc(x.time||'Sin hora')}</span></div><div><strong>${esc(x.type)} · ${esc(x.priority)}</strong><div class="agenda-text">${esc(x.text)}</div></div><div class="agenda-actions"><button data-agenda-done="${esc(x.id)}" title="Completar">${x.done?'↩':'✓'}</button><button data-agenda-del="${esc(x.id)}" title="Eliminar">🗑</button></div></div>`).join(''):'<div class="empty">No hay asuntos en esta vista.</div>';box.querySelectorAll('[data-agenda-done]').forEach(b=>b.onclick=()=>{const x=data.agenda.find(a=>a.id===b.dataset.agendaDone);if(x){x.done=!x.done;save('Agenda actualizada');scheduleGoogleAgendaSync()}});box.querySelectorAll('[data-agenda-del]').forEach(b=>b.onclick=()=>{data.agenda=data.agenda.filter(a=>a.id!==b.dataset.agendaDel);save('Asunto eliminado');scheduleGoogleAgendaSync()})}
