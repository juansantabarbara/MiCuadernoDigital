  function studentAttendanceSummary(studentId){
    const rows=Object.entries(data.attendance||{}).map(([date,rec])=>({date,value:rec?.[studentId]})).filter(x=>x.value);
    const absences=rows.filter(x=>x.value==='F');
    const lates=rows.filter(x=>x.value==='R');
    const total=rows.length;
    const present=rows.filter(x=>x.value!=='F').length;
